{
  "manifest_version": 3,
  "name": "Better Peakbagger — Gaia prototype",
  "version": "0.1.0",
  "description": "Prepares a Peakbagger ascent GPX in Gaia GPS for manual review and saving.",
  "minimum_chrome_version": "128",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://www.peakbagger.com/*", "https://peakbagger.com/*"],
  "optional_host_permissions": ["https://www.gaiagps.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Send GPX to Gaia", "default_popup": "popup.html"}
}
