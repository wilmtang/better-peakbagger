{
  "name": "better-peakbagger",
  "version": "3.6.0",
  "description": "Captures Garmin and Strava into Peakbagger drafts, plus 3D maps, GPX analysis, beta filters, dark mode, and more.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "wilmtang",
  "homepage": "https://github.com/wilmtang/better-peakbagger",
  "repository": {
    "type": "git",
    "url": "https://github.com/wilmtang/better-peakbagger.git"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --minify",
    "watch": "node scripts/build.mjs --watch",
    "start": "node scripts/run-development.mjs",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "test:scale": "npm run build && node --test \"test/scale/**/*.scale.mjs\"",
    "lint": "eslint src options popup photos scripts test && npm run build && node scripts/check-web-ext-lint.mjs",
    "audit:ci": "node scripts/check-npm-audit.mjs",
    "verify:chrome": "npm run build && node scripts/verify-extension.mjs",
    "verify:firefox": "npm run build && node scripts/verify-firefox-extension.mjs",
    "verify:browsers": "npm run build && node scripts/verify-extension.mjs && node scripts/verify-firefox-extension.mjs",
    "verify:packages": "node scripts/verify-packaged-extensions.mjs",
    "terrain:verify": "npm run build && node scripts/verify-terrain-visual.mjs",
    "terrain:verify:firefox": "npm run build && node scripts/verify-firefox-terrain.mjs",
    "terrain:lod": "npm run build && node scripts/verify-terrain-lod.mjs",
    "showcase:render": "npm run build && node scripts/render-showcase.mjs",
    "package": "npm run build:release && web-ext build --source-dir dist --overwrite-dest",
    "build:firefox": "node scripts/build-firefox-package.mjs",
    "release:bump": "node scripts/release-bump.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:check-history": "node scripts/check-changelog-history.mjs",
    "release:metadata:firefox": "node scripts/create-amo-metadata.mjs web-ext-artifacts/amo-metadata.json",
    "release:sign:firefox": "web-ext sign --source-dir=web-ext-artifacts/firefox-source --channel=listed --amo-metadata=web-ext-artifacts/amo-metadata.json --approval-timeout=0 --timeout=600000 --no-input",
    "release:verify-archive": "node scripts/verify-release-archive.mjs",
    "store:description:chrome": "node scripts/create-chrome-description.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-highlight": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-subscript": "^3.29.2",
    "@tiptap/extension-superscript": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-text-style": "^3.29.2",
    "@tiptap/extensions": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/starter-kit": "^3.29.2",
    "chart.js": "^4.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "jszip": "^3.10.1",
    "maplibre-gl": "^6.2.0",
    "marked": "^18.0.9",
    "playwright": "^1.62.1",
    "selenium-webdriver": "^4.47.0",
    "tz-lookup": "^6.1.25",
    "web-ext": "^10.6.0"
  },
  "overrides": {
    "firefox-profile": {
      "adm-zip": "0.6.0"
    },
    "fx-runner": {
      "shell-quote": "1.9.0"
    },
    "minimatch@^3.0.0": {
      "brace-expansion": "1.1.18"
    }
  },
  "webExt": {
    "sourceDir": "dist",
    "artifactsDir": "web-ext-artifacts"
  }
}
